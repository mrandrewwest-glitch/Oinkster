PORT=3000
# "mock" for local dev, "basiq" for real Australian bank connections and payments
BANKING_PROVIDER=mock
BASIQ_API_KEY=
# BASIQ_BASE_URL=https://au-api.basiq.io
# Where employers send payroll splits (from your banking/payments partner)
COLLECTION_ACCOUNT_NAME=Oinkster Savings Trust
COLLECTION_BSB=
COLLECTION_ACCOUNT_NUMBER=
# Shared secret the bank/provider sends in the x-webhook-secret header
WEBHOOK_SECRET=
# Optional: persist data to a JSON file
DATA_FILE=data/oinkster.json
